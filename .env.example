# Copy to .env and fill in your own values. Never commit .env.

# Main writer model
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=deepseek-flash

# Optional independent reviewer. Leave REVIEWER_* unset to reuse the writer client.
REVIEWER_API_KEY=
REVIEWER_BASE_URL=
REVIEWER_MODEL=

# off / sampled / strict. Use strict for untrusted environments.
REVIEW_MODE=strict
